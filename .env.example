# Database Configuration (Neon)
DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/dbname?sslmode=require

# Neon Object Storage (for recipe images)
AWS_S3_BUCKET=food-images
AWS_ENDPOINT_URL_S3=https://your-branch.storage.c-5.eu-central-1.aws.neon.tech
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
NEXT_PUBLIC_NEON_S3_PUBLIC_BASE=https://food-images.s3.eu-central-1.aws.neon.tech

# Optional: Application Settings
# DEBUG=True
# LOG_LEVEL=INFO
